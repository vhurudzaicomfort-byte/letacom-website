# Internal inbox that receives website enquiries (server-side only, never shown on the site)
CONTACT_INBOX_EMAIL=

# Optional: Resend transactional email. If unset, enquiries are relayed via FormSubmit.
RESEND_API_KEY=
# Sender on a Resend-verified domain, e.g. "Letacom Website <noreply@letacom.co.za>"
RESEND_FROM=
